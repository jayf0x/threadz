# Backend config — copy to .env (gitignored), edit, then `set -a && source .env && set +a`.
# Everything here has a working default; you usually don't need this file at all.

# --- Claude (the "Ask Claude" feature) ---
# By default the backend talks to Claude through the local `claude` CLI's auth via
# the Claude Code SDK — no API key needed. If "Ask Claude" returns an auth error,
# run:  claude login
# Alternatively, set an API key and the SDK/CLI will use that instead:
# ANTHROPIC_API_KEY=
# Default is claude-haiku-4-5-20251001 (cheap; fine for this). Override for Sonnet etc.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# CLAUDE_BIN=/Users/me/.local/bin/claude   # only if the SDK can't find the CLI

# --- Metadata generation (v2, off by default) ---
# Generated description/tags/embeddings/related-threads were tried for v1 and dropped (no solid
# place in the UI, output too weak). The code stays for a v2 revisit; set this to turn it back on.
# With it unset/0, nothing ever calls Ollama, and the /metadata and /related endpoints answer 503.
# THREADZ_METADATA=1

# --- Local models (Ollama) — only used when THREADZ_METADATA=1 ---
# Test defaults, not decisions: any Ollama model that emits JSON works. qwen3.5:0.8b followed the
# schema reliably in a quick test (gemma3:270m did not); nothing is benchmarked.
THREADZ_GEN_MODEL=qwen3.5:0.8b
THREADZ_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# --- Server ---
PORT=8787
THREADZ_DB=threadz.sqlite
# Photos are files, not SQLite rows. Default: an `images/` folder next to the database.
# THREADZ_IMAGES=images

# --- Frontend (optional) ---
# Where the PWA looks for the backend. Defaults to <current-host>:8787, so serving
# the app from the Mac's LAN IP just works.
# VITE_BACKEND_URL=http://192.168.178.44:8787
